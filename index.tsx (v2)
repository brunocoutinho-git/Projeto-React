import { useState } from "react";
import { ScrollView, Text, TouchableOpacity, View } from "react-native";
import FoodCard from "../components/FoodCard";
import { foods } from "../constants/foods";

export default function HomeScreen() {
  const [cartCount, setCartCount] = useState(0);
  const [total, setTotal] = useState(0);
  return (
    <ScrollView
      className="flex-1 bg-white px-4"
      showsVerticalScrollIndicator={false}
    >
      <View className="mb-6 mt-4">
        <Text className="text-base text-gray-500">Olá, seja bem vindo!</Text>

        <Text className="text-2xl font-bold text-gray-900">
          Gostaria de provar uma tapioca quentinha?
        </Text>
      </View>

      <View className="rounded-3xl bg-green-700 p-6">
        <Text className="text-sm font-bold text-white">Oferta Especial!</Text>
        <Text className="mt-2 text-3xl font-bold text-white">
          Leve duas tapiocas e ganhe uma água de coco grátis!
        </Text>
        <Text className="mt-2 text-base text-white">
          Uma bela combinação para seu lanche da tarde.
        </Text>
        <TouchableOpacity className="mt-5 self-start rounded-xl bg-white px-5 py-3">
          <Text className="font-bold text-green-700">Peça já!</Text>
        </TouchableOpacity>
      </View>

      <Text className="mt-8 mb-4 text-2xl font-bold">Categorias</Text>

      <View className="flex-row justify-between">
        <TouchableOpacity className="w-[30%] items-center rounded-2xl bg-yellow-100 py-3">
          <Text className="text-4xl">🥟</Text>
          <Text className="mt-2">Tapiocas</Text>
        </TouchableOpacity>

        <TouchableOpacity className="w-[30%] items-center rounded-2xl bg-yellow-100 py-3">
          <Text className="text-4xl">🥤</Text>
          <Text className="mt-2">Bebidas</Text>
        </TouchableOpacity>

        <TouchableOpacity className="w-[30%] items-center rounded-2xl bg-yellow-100 py-3">
          <Text className="text-4xl">🥐</Text>
          <Text className="mt-2">Salgados</Text>
        </TouchableOpacity>
      </View>
      <Text className="mt-8 mb-4 text-2xl font-bold">Principais Produtos</Text>
      <View className="text-full flex-row flex-wrap justify-between text-center">
        {foods.map((food) => (
          <FoodCard
            key={food.id}
            name={food.name}
            price={food.price}
            emoji={food.emoji}
            onAdd={() => {
              setCartCount(cartCount + 1);
              setTotal(total + food.price);
            }}
            onDelete={() => {
              setCartCount(Math.max(0, cartCount - 1));
              setTotal(Math.max(0, total - food.price));
            }}
          />
        ))}
      </View>
      <View className="flex-row">
        <View className="bg-green-700 flex-row justify-between items-center rounded-2xl py-3 w-[30%]">
          <Text className="text-base font-bold text-white mx-4">
            Items no Carrinho: {cartCount}
          </Text>
        </View>
        <View className="bg-green-700 items-center rounded-2xl py-3 w-[30%]">
          <Text className="text-base font-bold text-white mx-4">
            Total: R$ {total.toFixed(2)}
          </Text>
        </View>
      </View>
    </ScrollView>
  );
}
